{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "eslint/no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "env": { "browser": true },
      "rules": { "eslint/no-console": "error" }
    },
    {
      "files": ["tools/**/*.{js,mjs,cjs}"],
      "env": { "node": true, "browser": true }
    },
    {
      "files": ["tools/**/*.ts"],
      "env": { "node": true }
    },
    {
      "files": ["*.{js,mjs,cjs}"],
      "env": { "node": true }
    }
  ],
  "ignorePatterns": ["dist/**", "node_modules/**", "tools/shots/**"]
}
